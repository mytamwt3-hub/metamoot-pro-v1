-- منصة myta1 - قاعدة البيانات المحسنة - 20 جدول
-- تم تحسين الأنواع، القيود، الفهارس، وحقول الطوابع الزمنية (PostgreSQL)

-- دالة عامة لتحديث updated_at عند التعديل
CREATE OR REPLACE FUNCTION trigger_set_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ===== جدول الشركات =====
CREATE TABLE IF NOT EXISTS companies (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  tax_number VARCHAR(100),
  email VARCHAR(255),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== الفروع =====
CREATE TABLE IF NOT EXISTS branches (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  location VARCHAR(255),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_branches_company_name UNIQUE(company_id, name)
);

-- ===== المخازن =====
CREATE TABLE IF NOT EXISTS warehouses (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  branch_id BIGINT NOT NULL REFERENCES branches(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== الموظفون =====
CREATE TABLE IF NOT EXISTS employees (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  email VARCHAR(255),
  salary NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (salary >= 0),
  job_type VARCHAR(50),
  debt NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (debt >= 0),
  hired_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_employees_company_email UNIQUE(company_id, email)
);

-- ===== مستخدمو النظام =====
CREATE TABLE IF NOT EXISTS system_users (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT REFERENCES companies(id) ON DELETE SET NULL,
  email VARCHAR(255) NOT NULL,
  password_hash VARCHAR(255),
  role VARCHAR(50) NOT NULL DEFAULT 'user',
  login_type VARCHAR(20) NOT NULL DEFAULT 'password',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_system_users_company_email UNIQUE(company_id, email)
);

-- ===== المنتجات =====
CREATE TABLE IF NOT EXISTS products (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  barcode VARCHAR(100),
  price NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (price >= 0),
  quantity INT NOT NULL DEFAULT 0 CHECK (quantity >= 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_products_company_barcode UNIQUE(company_id, barcode)
);

-- ===== الموردون =====
CREATE TABLE IF NOT EXISTS suppliers (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  phone VARCHAR(50),
  debt NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (debt >= 0),
  credit NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (credit >= 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== فواتير المشتر��ات =====
CREATE TABLE IF NOT EXISTS purchase_invoices (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  supplier_id BIGINT REFERENCES suppliers(id) ON DELETE SET NULL,
  invoice_number VARCHAR(100) NOT NULL,
  total_amount NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total_amount >= 0),
  status VARCHAR(50) NOT NULL DEFAULT 'draft',
  issued_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  due_date TIMESTAMPTZ,
  paid BOOLEAN NOT NULL DEFAULT false,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_purchase_invoice_per_company UNIQUE(company_id, invoice_number)
);

CREATE INDEX IF NOT EXISTS idx_purchase_invoices_company ON purchase_invoices(company_id);

-- ===== بنود فاتورة المشتريات =====
CREATE TABLE IF NOT EXISTS purchase_items (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  invoice_id BIGINT NOT NULL REFERENCES purchase_invoices(id) ON DELETE CASCADE,
  product_id BIGINT REFERENCES products(id) ON DELETE SET NULL,
  product_name VARCHAR(255) NOT NULL,
  price NUMERIC(12,2) NOT NULL CHECK (price >= 0),
  qty INT NOT NULL DEFAULT 1 CHECK (qty > 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== العملاء =====
CREATE TABLE IF NOT EXISTS customers (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  phone VARCHAR(50),
  debt NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (debt >= 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_customers_company_phone UNIQUE(company_id, phone)
);

-- ===== فواتير المبيعات =====
CREATE TABLE IF NOT EXISTS sales_invoices (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  customer_id BIGINT REFERENCES customers(id) ON DELETE SET NULL,
  invoice_number VARCHAR(100) NOT NULL,
  total_amount NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total_amount >= 0),
  status VARCHAR(50) NOT NULL DEFAULT 'draft',
  issued_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  paid BOOLEAN NOT NULL DEFAULT false,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT uq_sales_invoice_per_company UNIQUE(company_id, invoice_number)
);

-- ===== بنود فواتير المبيعات =====
CREATE TABLE IF NOT EXISTS sales_items (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  invoice_id BIGINT NOT NULL REFERENCES sales_invoices(id) ON DELETE CASCADE,
  product_id BIGINT REFERENCES products(id) ON DELETE SET NULL,
  product_name VARCHAR(255) NOT NULL,
  price NUMERIC(12,2) NOT NULL CHECK (price >= 0),
  qty INT NOT NULL DEFAULT 1 CHECK (qty > 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== الشركاء =====
CREATE TABLE IF NOT EXISTS partners (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  capital NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (capital >= 0),
  profit NUMERIC(14,2) NOT NULL DEFAULT 0,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== طلبات المخزن / الطلبات =====
CREATE TYPE IF NOT EXISTS order_status AS ENUM ('pending','confirmed','shipped','delivered','cancelled');

CREATE TABLE IF NOT EXISTS store_orders (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  status order_status NOT NULL DEFAULT 'pending',
  total NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total >= 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== مندوبي التوصيل =====
CREATE TABLE IF NOT EXISTS delivery_persons (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  name VARCHAR(255) NOT NULL,
  phone VARCHAR(50),
  is_available BOOLEAN NOT NULL DEFAULT true,
  current_lat NUMERIC(10,8),
  current_lng NUMERIC(11,8),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== التوصيلات =====
CREATE TYPE IF NOT EXISTS delivery_status AS ENUM ('pending','assigned','in_transit','delivered','failed','cancelled');

CREATE TABLE IF NOT EXISTS deliveries (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  order_id BIGINT NOT NULL REFERENCES store_orders(id) ON DELETE CASCADE,
  delivery_person_id BIGINT REFERENCES delivery_persons(id) ON DELETE SET NULL,
  status delivery_status NOT NULL DEFAULT 'pending',
  confirmation_code VARCHAR(10),
  assigned_at TIMESTAMPTZ,
  delivered_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== طلبات الاستثمار =====
CREATE TABLE IF NOT EXISTS investment_requests (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL REFERENCES companies(id) ON DELETE CASCADE,
  product_name VARCHAR(255) NOT NULL,
  quantity INT NOT NULL DEFAULT 1 CHECK (quantity > 0),
  cost_price NUMERIC(12,2) NOT NULL CHECK (cost_price >= 0),
  selling_price NUMERIC(12,2) NOT NULL CHECK (selling_price >= 0),
  status VARCHAR(50) NOT NULL DEFAULT 'pending',
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== الاستثمارات =====
CREATE TABLE IF NOT EXISTS investments (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  request_id BIGINT NOT NULL REFERENCES investment_requests(id) ON DELETE CASCADE,
  total_funded NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (total_funded >= 0),
  remaining_qty INT NOT NULL DEFAULT 0 CHECK (remaining_qty >= 0),
  total_profit NUMERIC(14,2) NOT NULL DEFAULT 0,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== المحافظ =====
CREATE TABLE IF NOT EXISTS wallets (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  user_id BIGINT NOT NULL REFERENCES system_users(id) ON DELETE CASCADE,
  user_type VARCHAR(50) NOT NULL,
  balance NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (balance >= 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== الإعدادات العامة لكل شركة =====
CREATE TABLE IF NOT EXISTS settings (
  id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  company_id BIGINT NOT NULL UNIQUE REFERENCES companies(id) ON DELETE CASCADE,
  platform_name VARCHAR(255),
  currency VARCHAR(10) NOT NULL DEFAULT 'USD',
  platform_fee_percent NUMERIC(5,2) NOT NULL DEFAULT 5 CHECK (platform_fee_percent >= 0 AND platform_fee_percent <= 100),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ===== فهارس شائعة لتحسين الأداء على العلاقات =====
CREATE INDEX IF NOT EXISTS idx_branches_company_id ON branches(company_id);
CREATE INDEX IF NOT EXISTS idx_warehouses_branch_id ON warehouses(branch_id);
CREATE INDEX IF NOT EXISTS idx_employees_company_id ON employees(company_id);
CREATE INDEX IF NOT EXISTS idx_products_company_id ON products(company_id);
CREATE INDEX IF NOT EXISTS idx_suppliers_company_id ON suppliers(company_id);
CREATE INDEX IF NOT EXISTS idx_customers_company_id ON customers(company_id);
CREATE INDEX IF NOT EXISTS idx_sales_invoices_company_id ON sales_invoices(company_id);
CREATE INDEX IF NOT EXISTS idx_store_orders_company_id ON store_orders(company_id);
CREATE INDEX IF NOT EXISTS idx_delivery_persons_company_id ON delivery_persons(company_id);

-- ===== مشغلات لتحديث updated_at تلقائياً =====
-- أضف مشغلًا لكل جدول يريد تتبع updated_at
DO $$
BEGIN
  -- القوائم: أضف أو ازل بحسب الحاجة
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_companies_set_timestamp') THEN
    CREATE TRIGGER trg_companies_set_timestamp
    BEFORE UPDATE ON companies
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_branches_set_timestamp') THEN
    CREATE TRIGGER trg_branches_set_timestamp
    BEFORE UPDATE ON branches
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_warehouses_set_timestamp') THEN
    CREATE TRIGGER trg_warehouses_set_timestamp
    BEFORE UPDATE ON warehouses
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_employees_set_timestamp') THEN
    CREATE TRIGGER trg_employees_set_timestamp
    BEFORE UPDATE ON employees
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_system_users_set_timestamp') THEN
    CREATE TRIGGER trg_system_users_set_timestamp
    BEFORE UPDATE ON system_users
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_products_set_timestamp') THEN
    CREATE TRIGGER trg_products_set_timestamp
    BEFORE UPDATE ON products
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_suppliers_set_timestamp') THEN
    CREATE TRIGGER trg_suppliers_set_timestamp
    BEFORE UPDATE ON suppliers
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_purchase_invoices_set_timestamp') THEN
    CREATE TRIGGER trg_purchase_invoices_set_timestamp
    BEFORE UPDATE ON purchase_invoices
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_purchase_items_set_timestamp') THEN
    CREATE TRIGGER trg_purchase_items_set_timestamp
    BEFORE UPDATE ON purchase_items
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_customers_set_timestamp') THEN
    CREATE TRIGGER trg_customers_set_timestamp
    BEFORE UPDATE ON customers
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_sales_invoices_set_timestamp') THEN
    CREATE TRIGGER trg_sales_invoices_set_timestamp
    BEFORE UPDATE ON sales_invoices
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_sales_items_set_timestamp') THEN
    CREATE TRIGGER trg_sales_items_set_timestamp
    BEFORE UPDATE ON sales_items
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_partners_set_timestamp') THEN
    CREATE TRIGGER trg_partners_set_timestamp
    BEFORE UPDATE ON partners
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_store_orders_set_timestamp') THEN
    CREATE TRIGGER trg_store_orders_set_timestamp
    BEFORE UPDATE ON store_orders
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_delivery_persons_set_timestamp') THEN
    CREATE TRIGGER trg_delivery_persons_set_timestamp
    BEFORE UPDATE ON delivery_persons
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_deliveries_set_timestamp') THEN
    CREATE TRIGGER trg_deliveries_set_timestamp
    BEFORE UPDATE ON deliveries
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_investment_requests_set_timestamp') THEN
    CREATE TRIGGER trg_investment_requests_set_timestamp
    BEFORE UPDATE ON investment_requests
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_investments_set_timestamp') THEN
    CREATE TRIGGER trg_investments_set_timestamp
    BEFORE UPDATE ON investments
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_wallets_set_timestamp') THEN
    CREATE TRIGGER trg_wallets_set_timestamp
    BEFORE UPDATE ON wallets
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_settings_set_timestamp') THEN
    CREATE TRIGGER trg_settings_set_timestamp
    BEFORE UPDATE ON settings
    FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();
  END IF;
END$$;

